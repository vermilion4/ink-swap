# Your Claude API key, from https://console.anthropic.com
# Used by the test scripts, the demo video capture and, when shared, the built extension.
ANTHROPIC_API_KEY=sk-ant-...

# true: build ANTHROPIC_API_KEY into the extension (npm run build / npm run submission), so
#       whoever installs that copy can translate without a key of their own, e.g. judges.
#       Anyone with the built files can read the key: share them privately, revoke it after.
# false (default): users paste their own key in the popup.
INKSWAP_SHARED_KEY=false
