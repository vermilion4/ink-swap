{
  "name": "inkswap",
  "description": "Translate raw manga in place, bubble by bubble, by meaning.",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "INKSWAP_SHARED_KEY=false wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "demo:pages": "bash demo/fetch-pages.sh",
    "demo:capture": "npm run build && node --env-file=.env demo/capture.mjs",
    "demo:compose": "node demo/edit.mjs",
    "demo:thumbs": "node demo/thumbs.mjs",
    "demo:video": "npm run demo:capture && npm run demo:compose && npm run demo:thumbs",
    "submission": "node scripts/make-submission.mjs",
    "site": "python3 -m http.server 4173 -d site"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "zod": "^4.6.5"
  }
}
